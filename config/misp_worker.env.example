# Wazuh MISP worker - example environment file
# Version: 1.6
# Copy to /var/ossec/etc/misp_worker.env and edit values.
#
# IMPORTANT:
# - Never commit real API keys.
# - Prefer TLS verification with a CA bundle (MISP_VERIFY=/path/to/ca-bundle.crt).
# - This worker expects the forwarder to XADD raw alerts into a Redis Stream field named "alert".

# -----------------------------
# Redis
# -----------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM=wazuh:misp:in
REDIS_GROUP=misp
REDIS_CONSUMER=worker-1

# Read tuning (optional)
REDIS_READ_COUNT=200
REDIS_BLOCK_MS=1000

# Pending recovery on startup (Redis >= 6.2 required for XAUTOCLAIM).
# Set to 1 to re-process any messages that were in-flight when the worker last stopped.
# Startup recovery follows the XAUTOCLAIM cursor through one complete pending scan.
PROCESS_PENDING_ON_START=1

# Periodic autoclaim of stale in-flight messages (disabled by default).
# When enabled, the reader loop reclaims messages idle for AUTOCLAIM_IDLE_MS every 30s.
AUTOCLAIM_LOOP=0
AUTOCLAIM_IDLE_MS=60000
AUTOCLAIM_COUNT=200

# -----------------------------
# Stream retention 
# -----------------------------
# XACK removes a message from the consumer-group pending list but NOT from the stream
# itself. Without trimming, the stream grows unboundedly and will exhaust Redis memory.
# The worker calls XTRIM MAXLEN ~ every STREAM_TRIM_INTERVAL_SEC seconds.
# Approximate trimming (~) is used so XTRIM is O(1) rather than O(n).
#
# STREAM_MAXLEN: maximum number of entries to retain. Tune to your alert volume and
# available Redis memory. At ~1 KB/message, 100 000 entries ~= 100 MB.
STREAM_MAXLEN=100000

# How often to trim (seconds). Defaults to HEARTBEAT_SEC (trim every heartbeat).
STREAM_TRIM_INTERVAL_SEC=30

# Set STREAM_MAXLEN=0 to disable trimming entirely (not recommended).
# STREAM_MAXLEN=0

# -----------------------------
# Cache / Dedupe
# -----------------------------
# Short-window dedup: prevents hammering MISP when the same observable repeats in a burst.
DEDUP_TTL=2

# Positive cache (hits): how long to keep a successful MISP match result.
CACHE_HIT_TTL=3600

# Negative cache (misses): how long to remember "not found in MISP".
CACHE_MISS_TTL=600

# -----------------------------
# MISP
# -----------------------------
# Base URL of the MISP instance - host only, no trailing path.
# The worker appends /attributes/restSearch automatically.
MISP_BASE_URL=https://misp.example.local

# API key (DO NOT COMMIT real value)
MISP_API_KEY=REPLACE_ME

# TLS verification:
# - Recommended: path to a CA bundle, e.g. /etc/ssl/certs/ca-certificates.crt
# - For testing ONLY: set to 0 to disable verification (NOT safe in production)
MISP_VERIFY=/etc/ssl/certs/ca-certificates.crt
# MISP_VERIFY=0

# HTTP timeouts (seconds). Keep these tight to avoid thread starvation.
# Total max wait per observable = CONNECT + READ = 3 s by default.
MISP_TIMEOUT_CONNECT=0.5
MISP_TIMEOUT_READ=2.5

# Max attributes to keep per observable in the output payload and cache.
MISP_MAX_ATTRS=5

# Two-step MISP query: first fetch limit=MISP_FAST_LIMIT to check existence cheaply,
# then fetch up to MISP_MAX_ATTRS on a hit. Set to 0 for single-shot (not recommended).
MISP_FAST_LIMIT=1
MISP_FAST_PAGE=1

# Behavior on MISP query error (only applies when DLQ_MAX_RETRIES=0):
# - 1: ACK the message anyway (pipeline continues; enrichment is lost during outages)
# - 0: do NOT ACK (message stays pending and will be re-delivered)
ACK_ON_MISP_ERROR=1

# ------------------
# Dead-letter queue  
# ------------------
# Messages whose MISP query fails remain pending while retries are available,
# regardless of ACK_ON_MISP_ERROR. After DLQ_MAX_RETRIES failures, the worker writes
# the message to DLQ_STREAM with failure metadata (dlq_reason, dlq_retries, dlq_ts,
# dlq_src_id), then acks it from the main stream. A failed DLQ write leaves the
# source pending.
#
# Retry counter is stored in Redis (key: misp:retries:<msg_id>) with a TTL of
# DLQ_RETRY_TTL_SEC. The TTL resets the counter if the message is not re-delivered
# within that window (e.g. after a long MISP outage).
#
# Same-message retries bypass the short dedupe key so they can be processed again.
# Set DLQ_MAX_RETRIES=0 to disable DLQ entirely (falls back to ACK_ON_MISP_ERROR).

# Stream where permanently failed messages are written for manual inspection.
DLQ_STREAM=wazuh:misp:dead

# Number of MISP failures before a message is moved to the dead-letter stream.
DLQ_MAX_RETRIES=5

# TTL (seconds) for the per-message retry counter in Redis.
DLQ_RETRY_TTL_SEC=3600

# ----------------
# Circuit breaker 
# ----------------
# When MISP is down, every observable query blocks for up to MISP_TIMEOUT_CONNECT +
# MISP_TIMEOUT_READ seconds. With 8 threads all timing out simultaneously, the queue
# backs up and alert processing stalls. The circuit breaker prevents this.
#
# After CB_OPEN_THRESHOLD consecutive MISP errors (across all threads) the circuit
# OPENS: threads skip MISP queries and mark observables as unmatched so the stream
# keeps draining at full speed. After CB_RESET_SEC seconds the circuit moves to
# HALF_OPEN and allows exactly one probe. On success it CLOSES; on failure it
# reopens for another CB_RESET_SEC window.
#
# Circuit breaker state (closed/open/half_open) is reported in every heartbeat log.
# Set CB_OPEN_THRESHOLD=0 to disable the circuit breaker entirely.

# Consecutive error threshold to open the circuit.
CB_OPEN_THRESHOLD=10

# Seconds to wait before attempting a probe after the circuit opens.
CB_RESET_SEC=60

# -----------------------------
# Wazuh output
# -----------------------------
# Wazuh manager UNIX datagram socket path.
WAZUH_QUEUE=/var/ossec/queue/sockets/queue

# -----------------------------
# Extractors (optional YAML override)
# -----------------------------
# If this file exists, the worker merges its rules with (or replaces) the built-in
# defaults. Reload at runtime without restart by sending SIGHUP to the worker process.
# Built-in defaults cover:
# - Generic IP fields (srcip / dstip and common variants)
# - Generic FQDN fields (data.fqdn / data.domain / data.hostname)
# - Sysmon Event 3 (network connections: IPs + destination hostname)
# - Sysmon Event 22 (DNS queries: QueryName)
# - Sysmon any event (file hashes via Hashes KV field)
# - FIM / syscheck events (sha256 / sha1 / md5 before+after)
#
# NOTE: rules no longer require "groups_any: [to_misp]" -- all alerts are processed.
# Use decoder / provider / event_id / groups_any conditions to narrow extraction scope.
EXTRACTORS_FILE=/var/ossec/etc/misp_extractors.yml

# -----------------------------
# Concurrency
# -----------------------------
# Number of worker threads. Rule of thumb:
#   WORKER_THREADS ~= target_throughput_per_sec x (MISP_TIMEOUT_CONNECT + MISP_TIMEOUT_READ)
# Example: 10 alerts/s x 3 s timeout = 30 threads to avoid queue backlog.
# Increase carefully -- each thread holds a persistent TCP connection to MISP.
WORKER_THREADS=8

# Max items buffered between the reader and worker threads.
# The reader applies backpressure (stops reading Redis) when the queue is full.
QUEUE_MAX=2000

# -----------------------------
# Logging / observability
# -----------------------------
LOG_FILE=/var/ossec/logs/misp_worker.log

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Heartbeat interval (seconds). Each heartbeat logs:
#   stream_len, pending, last_delivered_id, queue depth, circuit breaker state,
#   and per-window counters: processed / obs / matched / unmatched /
#   misp_queries / misp_errors / exceptions / dlq.
HEARTBEAT_SEC=30

# TRACE=1 enables per-message debug logging (observable list, CB state, cache hits).
# Very verbose -- only use for troubleshooting individual alerts.
TRACE=0
