# Wazuh MISP worker - example environment file
# Copy to /var/ossec/etc/misp_worker.env and edit values.
#
# IMPORTANT:
# - Never commit real API keys.
# - Prefer TLS verification with a CA bundle (MISP_VERIFY=/path/to/ca-bundle.crt).
# - This worker expects the forwarder to XADD raw alerts into a Redis Stream field named "alert".

# -----------------------------
# Redis
# -----------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM=wazuh:misp:in
REDIS_GROUP=misp
REDIS_CONSUMER=worker-1

# Read tuning (optional)
REDIS_READ_COUNT=200
REDIS_BLOCK_MS=1000

# Pending recovery (Redis >= 6.2 for XAUTOCLAIM)
PROCESS_PENDING_ON_START=1
AUTOCLAIM_IDLE_MS=60000

# -----------------------------
# Cache / Dedupe
# -----------------------------
# Dedupe: prevents hammering MISP when the same observable repeats in a short burst
DEDUP_TTL=2

# Positive cache (hits): how long to keep successful matches
CACHE_HIT_TTL=3600

# Negative cache (misses): how long to remember "not found"
CACHE_MISS_TTL=600

# -----------------------------
# MISP
# -----------------------------
# Point to the attributes restSearch endpoint (POST).
# Example: https://misp.example.local/attributes/restSearch
MISP_BASE_URL=https://misp.example.local/attributes/restSearch

# API key (DO NOT COMMIT real value)
MISP_API_KEY=REPLACE_ME

# TLS verification:
# - Recommended: path to a CA bundle, e.g. /etc/ssl/certs/ca-certificates.crt
# - For testing ONLY: set to 0 to disable verification (NOT recommended in production)
MISP_VERIFY=/etc/ssl/certs/ca-certificates.crt
# MISP_VERIFY=0

# HTTP timeouts (seconds)
MISP_TIMEOUT_CONNECT=0.5
MISP_TIMEOUT_READ=2.5

# Max number of attributes to keep per match in the output payload/cache
MISP_MAX_ATTRS=5

# Fallback substring search for composite values (filename|sha256, domain|ip, etc.)
MISP_FALLBACK_SEARCHALL=1
# If enabled, wraps searchall value with %...% for substring matching
MISP_SEARCHALL_WRAP_PERCENT=1

# Behavior on MISP error:
# - 1: ACK the message anyway (pipeline continues; you may miss enrichment during outages)
# - 0: do NOT ACK (message remains pending for later retry)
ACK_ON_MISP_ERROR=1

# -----------------------------
# Wazuh output
# -----------------------------
# Wazuh manager UNIX datagram queue socket
WAZUH_QUEUE=/var/ossec/queue/sockets/queue

# -----------------------------
# Extractors (optional override)
# -----------------------------
# If this file exists, worker will load it.
# If not present, worker uses built-in defaults for:
# - Generic IP fields (src/dst)
# - Sysmon (FQDN + Hashes)
# - FIM/syscheck hashes
EXTRACTORS_FILE=/var/ossec/etc/misp_extractors.yml

# -----------------------------
# Logging / observability
# -----------------------------
LOG_FILE=/var/ossec/logs/misp_worker.log
LOG_LEVEL=INFO

# Heartbeat log interval (seconds). Shows stream_len/pending/last_delivered_id + counters.
HEARTBEAT_SEC=30

# TRACE=1 logs per-message observables and MISP request payloads (very verbose)
TRACE=0