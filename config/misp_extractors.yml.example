# Wazuh to MISP worker extractors (example)
#
# Goal: extract ONLY these observable families:
#   - IP (public/global)
#   - FQDN
#   - HASH (md5/sha1/sha256)
#
# IMPORTANT (updated):
# - The worker no longer requires alerts to carry the "to_misp" group.
# - Therefore, rules in this file should NOT rely on groups_any: ["to_misp"].
# - Use "when" only to *narrow* matching (optional), e.g. sysmon provider/event_id or syscheck group.

version: 1

# If true, built-in defaults are loaded first, then these rules are appended.
# If false, ONLY the rules in this file are used.
include_defaults: true

# If true, stop after the first matching rule. If false, apply all matching rules.
stop_on_match: false

rules:
  # ------------------------------------------------------------
  # Example 1: Add extra generic IP/FQDN fields (applies to any alert)
  # ------------------------------------------------------------
  - name: extra_generic_fields
    when: {}
    extract:
      - type: ip
        path_any:
          - data.network.src_ip
          - data.network.dst_ip
          - data.src.ip
          - data.dst.ip
          - data.client.ip
          - data.server.ip
      - type: fqdn
        path_any:
          - data.dns.query
          - data.http.host
          - data.tls.sni

  # ------------------------------------------------------------
  # Example 2: Sysmon Event ID 3 (Network) alternative paths
  # (narrowed by decoder/provider/event_id)
  # ------------------------------------------------------------
  - name: sysmon_event3_alt
    when:
      decoder: "windows_eventchannel"
      provider: "Microsoft-Windows-Sysmon"
      event_id: "3"
    extract:
      - type: fqdn
        path_any:
          - data.win.eventdata.DestinationHostname
          - data.win.eventdata.DestinationHostName  # (example variant)

  # ------------------------------------------------------------
  # Example 3: Sysmon Event ID 22 (DNS) alternative paths
  # ------------------------------------------------------------
  - name: sysmon_event22_dns_alt
    when:
      decoder: "windows_eventchannel"
      provider: "Microsoft-Windows-Sysmon"
      event_id: "22"
    extract:
      - type: fqdn
        path_any:
          - data.win.eventdata.QueryName
          - data.win.eventdata.QueryResults  # (example, depends on source)

  # ------------------------------------------------------------
  # Example 4: Hashes from a custom string field (auto-detect)
  # ------------------------------------------------------------
  - name: custom_hash_blob
    when: {}
    extract:
      # type: hash means "auto-detect md5/sha1/sha256 from string"
      # modes:
      # - sysmon_kv: expects "MD5=...,SHA1=...,SHA256=..."
      # - auto: scans for 32/40/64 hex tokens inside the string
      - type: hash
        path: data.hash_blob
        mode: auto

  # ------------------------------------------------------------
  # Example 5: FIM/syscheck additional paths
  # (narrowed by group "syscheck" to avoid scanning every alert)
  # ------------------------------------------------------------
  - name: fim_extra
    when:
      groups_any: ["syscheck"]
    extract:
      - type: sha256
        path_any:
          - syscheck.sha256_after
          - syscheck.sha256_before
          - data.syscheck.sha256_after
      - type: md5
        path_any:
          - syscheck.md5_after
          - syscheck.md5_before

  # ------------------------------------------------------------
  # Example 6: Optional targeting by groups (NOT required)
  # Use this only if you want to limit extraction on specific alert families.
  # ------------------------------------------------------------
  - name: only_web_and_auth
    when:
      groups_any: ["web", "web_scan", "sshd", "authentication_failed"]
    extract:
      - type: ip
        path_any:
          - data.srcip
          - data.dstip
      - type: fqdn
        path_any:
          - data.url_domain
          - data.http.host
