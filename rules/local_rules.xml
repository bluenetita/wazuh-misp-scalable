<group name="misp,">

  <rule id="200110" level="10">
    <field name="integration">misp</field>
    <description>MISP integration event detected</description>
    <options>no_full_log</options>
  </rule>

  <rule id="200111" level="5">
    <if_sid>200620</if_sid>
    <field name="misp.error">\.+</field>
    <description>MISP - API connection failure</description>
    <options>no_full_log</options>
    <group>misp_error,</group>
  </rule>

  <rule id="200112" level="12">
    <field name="misp.category">\.+</field>
    <description>MISP - Threat Intelligence match detected | Category: $(misp.category) | Value: $(misp.value)</description>
    <options>no_full_log</options>
    <group>misp_alert,</group>
  </rule>

</group>